# Binance Spot TESTNET (Spielgeld). Keys erzeugen auf https://testnet.binance.vision (Login mit GitHub).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Interactive Brokers: Paper-Konto-Kennung (beginnt mit DU). TWS oder IB Gateway muss laufen,
# API aktiviert (Configure > API > Settings), Paper-Port: Gateway 4002, TWS 7497.
IB_ACCOUNT_ID=
IB_HOST=127.0.0.1
IB_PORT=4002
# delayed (Standard, ohne Marktdaten-Abo) oder realtime
IB_MARKET_DATA=delayed
